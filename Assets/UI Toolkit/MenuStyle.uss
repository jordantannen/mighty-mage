:root {
}

.header {
    -unity-font-definition: url("project://database/Assets/Fonts/AoboshiOne-Regular.ttf?fileID=12800000&guid=c2442f84838de456182f6efa59c71d7a&type=3#AoboshiOne-Regular");
    -unity-text-align: upper-center;
    -unity-font-style: normal;
    font-size: 64px;
}

.button {
    background-image: url("project://database/Assets/Sprites/UI/panel-transparent-center-015.png?fileID=21300000&guid=3c1292927439547188c2ec83f83c4ccf&type=3#panel-transparent-center-015");
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(0, 0, 0);
    width: 250px;
    height: 60px;
    -unity-font-definition: url("project://database/Assets/Fonts/AoboshiOne-Regular.ttf?fileID=12800000&guid=c2442f84838de456182f6efa59c71d7a&type=3#AoboshiOne-Regular");
    font-size: 28px;
    color: rgb(207, 207, 207);
    -unity-text-align: middle-center;
    justify-content: center;
    align-content: center;
    align-items: center;
    align-self: center;
    flex-direction: column-reverse;
    padding-top: 5px;
    margin-top: 32px;
    transition-duration: 0.35s;
}

.button:hover {
    scale: 1.1 1.1;
    background-color: rgb(51, 51, 51);
}

.survival-time {
    -unity-font-definition: url("project://database/Assets/Fonts/AoboshiOne-Regular.ttf?fileID=12800000&guid=c2442f84838de456182f6efa59c71d7a&type=3#AoboshiOne-Regular");
    -unity-text-align: middle-center;
    font-size: 32px;
    color: rgb(229, 229, 229);
    margin-top: 20px;
    margin-bottom: 10px;
}

